{
  "name": "appointment-backend",
  "version": "1.0.0",
  "description": "SmartOffice Appointment System Backend",
  "scripts": {
    
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node src/seed.ts",
    "fix:db": "node scripts/fix-null-emails.js",
    "reset:db": "node scripts/reset-database.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
